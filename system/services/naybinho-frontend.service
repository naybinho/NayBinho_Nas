[Unit]
Description=NayBinho NAS Frontend (Nginx)
Documentation=https://github.com/naybinho/nas
After=network.target network-online.target naybinho-backend.service
Wants=network-online.target
Requires=naybinho-backend.service

[Service]
Type=forking
PIDFile=/run/nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /opt/naybinho/system/nginx/naybinho.conf
ExecStart=/usr/sbin/nginx -c /opt/naybinho/system/nginx/naybinho.conf
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s QUIT $MAINPID
PrivateTmp=true

# Restart automático
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=30

# Segurança
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=true

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=naybinho-frontend

TimeoutStartSec=20
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
